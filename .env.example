# -------------------------------------------------------
# CLIENT-SAFE LICENSE (.env for production / client PC)
# Copy these into the client .env and run: php artisan config:clear
# -------------------------------------------------------
LICENSE_ENFORCED=true
LICENSE_BIND_MACHINE=true
LICENSE_INCLUDE_HOSTNAME=true
LICENSE_SIGNING_SECRET=replace-with-strong-unique-secret
LICENSE_ISSUER="${APP_NAME}"

# -------------------------------------------------------
# LOCAL / DEV (do NOT use on client)
# -------------------------------------------------------
# LICENSE_ENFORCED=false
# LICENSE_BIND_MACHINE=false
# LICENSE_INCLUDE_HOSTNAME=false

# -------------------------------------------------------
# Generate token (on your portal / admin machine with same SECRET):
# 1. Open client /license/activate and copy Machine fingerprint
# 2. php artisan license:generate-token "KEY" "FINGERPRINT" --customer="Name" --days=365
# 3. Paste key + token on client activate page
# -------------------------------------------------------

# -------------------------------------------------------
# DAILY + WEEKLY BACKUP
# {BACKUP_PATH}\daily\YYYY-MM-DD\  → prune after RETENTION_DAYS
# {BACKUP_PATH}\weekly\YYYY-MM-Wn\ → forever
# -------------------------------------------------------
# BACKUP_PATH=D:\ValiflowBackups
# BACKUP_RETENTION_DAYS=7
# BACKUP_DAILY_AT=02:00
# BACKUP_USE_NATIVE_SQLSRV=true
# BACKUP_WEEKLY_ENABLED=true

# -------------------------------------------------------
# SMTP MAIL CONFIGURATION
# -------------------------------------------------------
# MAIL_MAILER=smtp
# MAIL_HOST=172.21.34.19
# MAIL_PORT=25
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=null
# MAIL_FROM_ADDRESS=noreply@lupin.in
# MAIL_FROM_NAME="ValiFlow"
